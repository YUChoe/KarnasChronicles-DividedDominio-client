[node name="ConnectionIndicator" parent="." instance=ExtResource("2_indicator")]
unique_name_in_owner = true
layout_mode = 2

[node name="LocaleSelector" parent="." instance=ExtResource("3_locale")]
unique_name_in_owner = true
layout_mode = 2

[node name="Separator" type="HSeparator" parent="."]
layout_mode = 2

[node name="AdminButton" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Admin panel"

[node name="LogoutButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Sign out"

[node name="QuitButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"

[node name="CloseButton" type="Button" parent="."]
unique_name_in_owner = true
