[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/settings/settings.gd" id="1_settings"]
[ext_resource type="PackedScene" path="res://scenes/common/connection_indicator.tscn" id="2_indicator"]
[ext_resource type="PackedScene" path="res://scenes/common/locale_selector.tscn" id="3_locale"]

[node name="Settings" type="VBoxContainer"]
offset_right = 480.0
offset_bottom = 360.0
theme_override_constants/separation = 12
