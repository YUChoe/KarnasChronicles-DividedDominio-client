# 환경 설정 예시
# 실제 사용 시 .env 파일로 복사하여 사용하세요
# cp .env.example .env

# Node 환경
NODE_ENV=production

# WebSocket Gateway 설정
WS_PORT=3000

# MUD 서버 설정. 게임은 4000, 어드민은 4001 이다
TELNET_HOST=localhost
TELNET_PORT=4000
ADMIN_PORT=4001

# 연결 설정
# CONNECTION_TIMEOUT 은 프레임이 오가지 않은 연결을 닫는 기준이다 (밀리초).
# 클라이언트가 60초마다 ping 을 보내므로 그보다 넉넉해야 한다
MAX_CONNECTIONS=200
CONNECTION_TIMEOUT=300000

# 로그 설정
LOG_LEVEL=info

# 클라이언트 설정 (빌드 시 사용)
VITE_WS_URL=ws://localhost:3000/ws

# Web Admin Panel 설정
WEBADMIN_USERNAME=admin
WEBADMIN_PASSWORD=admin
DATA_DIR=data
