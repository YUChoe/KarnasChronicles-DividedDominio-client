# 환경 설정 예시
# 실제 사용 시 .env 파일로 복사하여 사용하세요
# cp .env.example .env

# Node 환경
NODE_ENV=production

# WebSocket Gateway 설정
WS_PORT=3000

# MUD 서버 설정. 게임은 4000, 어드민은 4001 이다
TELNET_HOST=localhost
TELNET_PORT=4000
ADMIN_PORT=4001

# 연결 설정
# CONNECTION_TIMEOUT 은 프레임이 오가지 않은 연결을 닫는 기준이다 (밀리초).
# 클라이언트가 60초마다 ping 을 보내므로 그보다 넉넉해야 한다
MAX_CONNECTIONS=200
CONNECTION_TIMEOUT=300000

# 로그 설정
LOG_LEVEL=info

# 랜딩 사이트 설정
# 랜딩은 소개 페이지뿐이며 계정 생성 기능이 없다. 계정 생성은 Godot
# 클라이언트가 게임 채널의 register 로 직접 한다
#
# 정적 자산은 프로덕션에서 nginx 가 서빙한다. 게이트웨이의 서빙은 개발용이며
# 1 일 때만 켜진다. 두 곳이 동시에 서빙하면 캐시 헤더와 경로 규칙이 갈라진다
LANDING_SERVE_STATIC=0
LANDING_STATIC_ROOT=src/server/public


# 웹 어드민 설정은 제거했다. 어드민은 MUD 서버의 어드민 채널(TCP 4001)로
# 이전했고 게이트웨이는 데이터베이스에 접근하지 않는다
