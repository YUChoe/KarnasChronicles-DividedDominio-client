{
  "name": "karnas-chronicles-gateway",
  "version": "1.0.0",
  "description": "WebSocket gateway and landing site for The Chronicles of Karnas: Divided Dominion",
  "type": "module",
  "scripts": {
    "dev:server": "bash -c './node_modules/.bin/tsx watch src/server/start.ts'",
    "build:server": "node node_modules/typescript/lib/tsc.js -p tsconfig.build.json && node scripts/write-cjs-marker.mjs",
    "build": "npm run build:server",
    "type-check": "node node_modules/typescript/lib/tsc.js -p tsconfig.server.json --noEmit",
    "type-check:server": "node node_modules/typescript/lib/tsc.js -p tsconfig.server.json --noEmit",
    "check:godot": "bash scripts/godot-check.sh",
    "test:godot": "bash scripts/godot-test.sh",
    "build:godot": "bash scripts/godot-build.sh",
    "build:godot:dev": "bash scripts/godot-build.sh --dev",
    "build:godot:web": "bash scripts/godot-build.sh --web",
    "check:contract": "python scripts/check-contract-coverage.py",
    "test": "bash -c './node_modules/.bin/vitest --run --config vitest.config.server.ts'",
    "test:server": "bash -c './node_modules/.bin/vitest --run --config vitest.config.server.ts'",
    "test:e2e": "bash -c './node_modules/.bin/vitest --run --config vitest.config.e2e.ts'",
    "test:load": "bash -c './node_modules/.bin/vitest --run --config vitest.config.load.ts'"
  },
  "keywords": [
    "websocket",
    "gateway",
    "mud"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "winston": "^3.14.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "fast-check": "^3.20.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
